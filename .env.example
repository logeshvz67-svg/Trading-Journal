# Copy to .env for local development. On Render, set these under Environment.
# Supabase -> Project Settings -> API (or "API Keys")

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public. Safe in the browser because Row Level Security protects every table.
SUPABASE_ANON_KEY=your-anon-public-key
# SECRET. Server only. Never put this in frontend code or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

PORT=3000

# Optional AI Mentor. Leave blank to run without AI. Set ONE provider:
# OpenRouter (takes priority if set). Model ids: https://openrouter.ai/models
OPENROUTER_API_KEY=
# Exact ids from openrouter.ai/models. Comma-separated = fallback chain.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-nano-9b-v2:free
# Used only for chart reviews (images): must be a vision model.
OPENROUTER_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
# Or Anthropic directly:
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=20
# Hard cap per reply (thinking + answer). Keeps each call cheap.
AI_MAX_TOKENS=1500
AI_MODEL=claude-opus-5-5
